# Copy to .env.selfhost. Never commit the real file.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000

POSTGRES_USER=agent_web
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=agent_web
DATABASE_URL=postgresql://agent_web:replace-with-a-long-random-password@postgres:5432/agent_web
CREDENTIAL_MASTER_KEY=replace-with-a-32-byte-base64url-key

# Save model credentials through /api-key after startup.
AI_ALLOW_INSECURE_HTTP=false
AI_TOKEN_PRICES_JSON=[]
AI_MAX_INPUT_CHARACTERS=160000
# No automatic output quota. Non-empty budgets below are explicit operator opt-ins only.
AI_OUTPUT_TOKEN_PARAMETER=auto
AI_OUTPUT_TOKEN_BUDGETS_JSON={}

# Internal SearXNG search service. It is not published to the host network.
WEB_SEARCH_BASE_URL=http://search:8080/
# Replace this value for deployments that expose or share the search service.
SEARXNG_SECRET=replace-with-a-long-random-search-secret

# Capacitor's packaged Android client uses https://localhost as its WebView
# origin. Keep this exact origin unless a platform shell is deliberately added.
MOBILE_ALLOWED_ORIGINS=https://localhost

# Optional reminder worker tuning. Defaults are suitable for one user.
REMINDER_WORKER_ID=
REMINDER_POLL_INTERVAL_MS=5000
PROACTIVITY_POLL_INTERVAL_MS=60000
SCHEDULER_BATCH_SIZE=20
SCHEDULER_LEASE_MS=60000
VAPID_SUBJECT=https://github.com/ghostzero-ai/agent_web
