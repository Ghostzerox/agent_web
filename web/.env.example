# PostgreSQL connection used by Drizzle Kit and the migration commands.
# Copy this file to .env.local and replace the credentials locally.
DATABASE_URL=postgresql://agent_web:change-me@127.0.0.1:5432/agent_web

# 32 random bytes encoded as unpadded base64url. This encrypts model
# credentials saved from /api-key and must never use a NEXT_PUBLIC_ prefix.
CREDENTIAL_MASTER_KEY=replace-with-a-32-byte-base64url-key

# Set Provider, Base URL, Model and API Key through /api-key; PostgreSQL is the only source.

# HTTP providers (for example a trusted LAN model server) are rejected unless
# the self-hosting administrator explicitly opts in.
AI_ALLOW_INSECURE_HTTP=false

# Optional per-model prices, not a built-in tariff. Empty means unknown cost.
# Array entries: providerOrigin, model, currency, inputPerMillion,
# cachedInputPerMillion, outputPerMillion, source (official URL), asOf (YYYY-MM-DD).
AI_TOKEN_PRICES_JSON=[]

# Text character guard, NOT an exact token/context-window count. No history is dropped.
AI_MAX_INPUT_CHARACTERS=160000
# auto enables max_tokens only on the verified official DeepSeek endpoint.
# For other endpoints opt in to max_tokens/max_completion_tokens, or use off.
AI_OUTPUT_TOKEN_PARAMETER=auto
# Optional per-business output ceilings, e.g. {"chat":16384,"game":8192}.
AI_OUTPUT_TOKEN_BUDGETS_JSON={}

# Optional SearXNG endpoint. Docker Compose supplies http://search:8080/.
WEB_SEARCH_BASE_URL=

# Optional settings for the independent reminder worker.
REMINDER_WORKER_ID=
REMINDER_POLL_INTERVAL_MS=5000
PROACTIVITY_POLL_INTERVAL_MS=60000
SCHEDULER_BATCH_SIZE=20
SCHEDULER_LEASE_MS=60000
VAPID_SUBJECT=https://github.com/ghostzero-ai/agent_web
